{
  "$defs": {
    "PollenAllergen": {
      "enum": [
        "alder",
        "birch",
        "hazel",
        "beech",
        "ash",
        "oak",
        "grasses",
        "ragweed"
      ],
      "title": "PollenAllergen",
      "type": "string"
    },
    "PollenDelivery": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "default": "off",
          "enum": [
            "off",
            "immediate",
            "daily_digest"
          ],
          "title": "Email",
          "type": "string"
        },
        "digest_at": {
          "anyOf": [
            {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest At"
        },
        "quiet_hours": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuietHours"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PollenDelivery",
      "type": "object"
    },
    "PollenPeriod": {
      "enum": [
        "observation_hourly",
        "observation_daily_00_24_utc",
        "observation_daily_06_06_utc",
        "forecast_instant"
      ],
      "title": "PollenPeriod",
      "type": "string"
    },
    "PollenRule": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "$ref": "#/$defs/PollenPeriod"
        },
        "unit": {
          "const": "number/m3",
          "default": "number/m3",
          "title": "Unit",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThresholdRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rapid_increase": {
          "anyOf": [
            {
              "$ref": "#/$defs/RapidIncreaseRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category_change": {
          "default": false,
          "title": "Category Change",
          "type": "boolean"
        }
      },
      "required": [
        "period"
      ],
      "title": "PollenRule",
      "type": "object"
    },
    "PollenSelection": {
      "additionalProperties": false,
      "properties": {
        "allergen": {
          "$ref": "#/$defs/PollenAllergen"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PollenRule"
          },
          "maxItems": 4,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "allergen"
      ],
      "title": "PollenSelection",
      "type": "object"
    },
    "QuietHours": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "QuietHours",
      "type": "object"
    },
    "RapidIncreaseRule": {
      "additionalProperties": false,
      "properties": {
        "minimum_increase": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,6}|(?=[\\d.]{1,13}0*$)\\d{0,6}\\.\\d{0,6}0*$)",
              "type": "string"
            }
          ],
          "title": "Minimum Increase"
        },
        "window_hours": {
          "maximum": 24,
          "minimum": 1,
          "title": "Window Hours",
          "type": "integer"
        }
      },
      "required": [
        "minimum_increase",
        "window_hours"
      ],
      "title": "RapidIncreaseRule",
      "type": "object"
    },
    "ThresholdRule": {
      "additionalProperties": false,
      "properties": {
        "trigger_at_or_above": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,6}|(?=[\\d.]{1,13}0*$)\\d{0,6}\\.\\d{0,6}0*$)",
              "type": "string"
            }
          ],
          "title": "Trigger At Or Above"
        },
        "reset_at_or_below": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,6}|(?=[\\d.]{1,13}0*$)\\d{0,6}\\.\\d{0,6}0*$)",
              "type": "string"
            }
          ],
          "title": "Reset At Or Below"
        }
      },
      "required": [
        "trigger_at_or_above",
        "reset_at_or_below"
      ],
      "title": "ThresholdRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "template_id": {
      "const": "pollen-watch",
      "default": "pollen-watch",
      "title": "Template Id",
      "type": "string"
    },
    "template_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Template Version",
      "type": "integer"
    },
    "station_id": {
      "pattern": "^[A-Z]{3}$",
      "title": "Station Id",
      "type": "string"
    },
    "selections": {
      "items": {
        "$ref": "#/$defs/PollenSelection"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Selections",
      "type": "array"
    },
    "timezone": {
      "default": "Europe/Zurich",
      "maxLength": 64,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "delivery": {
      "$ref": "#/$defs/PollenDelivery"
    }
  },
  "required": [
    "station_id",
    "selections"
  ],
  "title": "PollenConfiguration",
  "type": "object"
}
