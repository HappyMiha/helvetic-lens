# Local development uses SQLite when DATABASE_URL is empty.
# PostgreSQL example (Compose sets the database host automatically):
# DATABASE_URL=postgresql+psycopg://helvetic_lens:helvetic_lens@127.0.0.1:54329/helvetic_lens
DATABASE_URL=
DATABASE_POOL_SIZE=4
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=15
HELVETIC_LENS_DATA_DIR=./data
# Lightweight host development runs commands inline. Compose overrides this to
# Celery and supplies its private Redis address.
JOB_EXECUTION_MODE=inline
REDIS_URL=redis://127.0.0.1:63799/0
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
# Bound official synchronization independently from interactive work. The
# scheduler also pauses admission when its shared artifact volume is low.
CONNECTOR_MAX_ACTIVE_JOBS=2
CONNECTOR_MAX_QUEUE_DEPTH=20
CONNECTOR_MIN_FREE_MEGABYTES=512
INTEGRATION_LOG_RETENTION_DAYS=30
JOB_HISTORY_RETENTION_DAYS=90
ORPHAN_ARTIFACT_RETENTION_HOURS=24
AUTH_MAIL_RETENTION_HOURS=48

# Authentication. Local development may keep the existing anonymous workspace.
# Any internet-facing deployment must use production, disable anonymous access,
# and terminate HTTPS before the application so cookies remain Secure.
APP_ENVIRONMENT=development
ALLOW_ANONYMOUS_DEV=true
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=14
# Public address used in verification and password-reset links.
PUBLIC_BASE_URL=http://127.0.0.1:3000
# "development" writes one-time links to the private data volume for local use.
# Use "smtp" for a shared deployment or "disabled" when accounts are not enabled.
AUTH_EMAIL_MODE=development
AUTH_EMAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_STARTTLS=true
# Recommended for shared/production deployments. Use a long random value and
# back it up separately. Local development generates a key in the data volume.
HELVETIC_LENS_CREDENTIAL_KEY=

# Compose database identity, host-port, and persistent-volume overrides.
HELVETIC_LENS_DB_USER=helvetic_lens
HELVETIC_LENS_DB_PASSWORD=helvetic_lens
HELVETIC_LENS_DB_NAME=helvetic_lens
HELVETIC_LENS_DB_PORT=54329
HELVETIC_LENS_API_PORT=8000
HELVETIC_LENS_WEB_PORT=3000
HELVETIC_LENS_REDIS_PORT=63799
HELVETIC_LENS_POSTGRES_VOLUME=helvetic-lens_postgres_data
HELVETIC_LENS_DOCUMENT_VOLUME=helvetic-lens_document_data
HELVETIC_LENS_APERTUS_VOLUME=helvetic-lens_local_apertus_cache
HELVETIC_LENS_REDIS_VOLUME=helvetic-lens_redis_data

# Environment defaults. Settings in the app can override these without a restart.
# Use "infomaniak" with its numeric Product ID, "docker" for the optional local
# Apertus service, or "custom" with an API base URL.
# For Infomaniak the server derives APERTUS_BASE_URL, so it may remain empty.
APERTUS_PROVIDER=custom
APERTUS_PRODUCT_ID=
APERTUS_BASE_URL=
APERTUS_MODEL=swiss-ai/Apertus-v1.5-8B
APERTUS_API_KEY=
APERTUS_TIMEOUT_SECONDS=90
APERTUS_CONTEXT_CHARS=24000
APERTUS_MAX_TOKENS=1600
APERTUS_TEMPERATURE=0.1
APERTUS_TOP_P=1
APERTUS_PRESENCE_PENALTY=0
APERTUS_REASONING_EFFORT=default
APERTUS_JSON_MODE=false

# Optional override for the Local Docker Apertus provider. By default the API
# chooses the stable manager gateway on localhost:12436 for host development
# and model-manager:8090/openai/v1 in Compose.
LOCAL_APERTUS_BASE_URL=
MODEL_MANAGER_URL=http://127.0.0.1:12436
HELVETIC_LENS_MODEL_LIBRARY_VOLUME=helvetic-lens_model_library

# Optional, explicitly selected provider for HTML pages requiring rendering.
# Native HTML/PDF extraction works without Firecrawl.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Development only: permits the local synthetic demo server.
# Keep false for external/shared deployments.
ALLOW_PRIVATE_SOURCES=false
MAX_DOCUMENT_BYTES=8388608
FETCH_TIMEOUT_SECONDS=25
