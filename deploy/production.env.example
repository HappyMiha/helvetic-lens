# Copy to .env.production, replace every value marked CHANGE_ME, and keep it
# outside source control. The validator prints field names only, never secrets.
HELVETIC_LENS_RELEASE=CHANGE_ME_GIT_COMMIT
HELVETIC_LENS_DOMAIN=lens.example.ch
CADDY_ACME_EMAIL=operations@example.ch
PUBLIC_BASE_URL=https://lens.example.ch

APP_ENVIRONMENT=production
ALLOW_ANONYMOUS_DEV=false
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=14
DEFAULT_LOCALE=de-CH

AUTH_EMAIL_MODE=smtp
AUTH_EMAIL_FROM=Helvetic Lens <lens@example.ch>
AUTH_SMTP_HOST=smtp.example.ch
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=CHANGE_ME_SMTP_USER
AUTH_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
AUTH_SMTP_STARTTLS=true

HELVETIC_LENS_DB_USER=helvetic_lens
HELVETIC_LENS_DB_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD_AT_LEAST_24_CHARS
HELVETIC_LENS_DB_NAME=helvetic_lens
HELVETIC_LENS_CREDENTIAL_KEY=CHANGE_ME_RANDOM_CREDENTIAL_KEY_AT_LEAST_32_CHARS

APERTUS_PROVIDER=docker
APERTUS_MODEL=apertus-1.5b-q4km
APERTUS_TIMEOUT_SECONDS=180
APERTUS_CONTEXT_CHARS=12000
APERTUS_MAX_TOKENS=1200
APERTUS_TEMPERATURE=0.1
APERTUS_TOP_P=1
APERTUS_JSON_MODE=true

ALLOW_PRIVATE_SOURCES=false
MAX_DOCUMENT_BYTES=8388608
FETCH_TIMEOUT_SECONDS=25
JOB_EXECUTION_MODE=celery
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
CONNECTOR_MAX_ACTIVE_JOBS=2
CONNECTOR_MAX_QUEUE_DEPTH=20
CONNECTOR_MIN_FREE_MEGABYTES=2048
INTEGRATION_LOG_RETENTION_DAYS=30
JOB_HISTORY_RETENTION_DAYS=90
ORPHAN_ARTIFACT_RETENTION_HOURS=24
AUTH_MAIL_RETENTION_HOURS=48

# Absolute host path on a separate disk or protected mounted destination.
HELVETIC_LENS_BACKUP_DIR=/srv/helvetic-lens-backups
HELVETIC_LENS_DEPLOY_STATE_DIR=/srv/helvetic-lens/deploy-state
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
# The tracked production command uses this default path. Override only for a
# deliberate alternate environment file that is protected equally well.
HELVETIC_LENS_CONFIG_FILE=./.env.production
