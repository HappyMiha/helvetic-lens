#!/bin/sh
set -eu
. "$(git rev-parse --show-toplevel)/.githooks/common.sh"
require_main
[ "$1" = origin ] || die 'Use the named origin remote.'
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main)
            is_zero "$local_oid" && die 'Deleting main is prohibited.'
            git fetch --quiet --no-tags "$2" refs/heads/main </dev/null || die 'Cannot refresh remote main; nothing was pushed.'
            latest=$(git rev-parse --verify FETCH_HEAD)
            git merge-base --is-ancestor "$latest" "$local_oid" || die 'Remote main has missing changes. Fetch, integrate, review and retest; never force-push.'
            ;;
        refs/tags/*)
            is_zero "$local_oid" && die 'Deleting release tags is prohibited.'
            is_zero "$remote_oid" || die 'Replacing existing release tags is prohibited.'
            continue
            ;;
        *) die 'Publish development only to main; historical branches are not active destinations.' ;;
    esac
    if ! is_zero "$remote_oid"; then
        git merge-base --is-ancestor "$remote_oid" "$local_oid" || die 'This update would replace published history. Fetch and integrate; no force-push.'
    fi
done
